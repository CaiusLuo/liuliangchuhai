          }
        },
        "required": [
          "provider",
          "available"
        ],
        "title": "ProviderStatusResponse",
        "type": "object"
      },
      "ProvidersResponse": {
        "properties": {
          "digital_human": {
            "$ref": "#/components/schemas/ProviderStatusResponse"
          },
          "llm": {
            "$ref": "#/components/schemas/ProviderStatusResponse"
          }
        },
        "required": [
          "llm",
          "digital_human"
        ],
        "title": "ProvidersResponse",
        "type": "object"
      },
