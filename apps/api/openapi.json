{
  "components": {
    "schemas": {
      "AssistantActionType": {
        "enum": [
          "view_product",
          "start_analysis"
        ],
        "title": "AssistantActionType",
        "type": "string"
      },
      "AssistantChatRequest": {
        "additionalProperties": false,
        "properties": {
          "message": {
            "minLength": 1,
            "pattern": "\\S",
            "title": "Message",
            "type": "string"
          },
          "product_id": {
            "anyOf": [
              {
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Product Id"
          }
        },
        "required": [
          "message"
        ],
        "title": "AssistantChatRequest",
        "type": "object"
      },
      "AssistantChatResponse": {
        "properties": {
          "message": {
            "minLength": 1,
            "pattern": "\\S",
            "title": "Message",
            "type": "string"
          },
          "suggested_action": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AssistantSuggestedActionResponse"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "message",
          "suggested_action"
        ],
        "title": "AssistantChatResponse",
        "type": "object"
      },
      "AssistantErrorResponse": {
        "properties": {
          "code": {
            "enum": [
              "assistant_unavailable",
              "invalid_assistant_response"
            ],
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "AssistantErrorResponse",
        "type": "object"
      },
      "AssistantSuggestedActionResponse": {
        "properties": {
          "product_id": {
            "title": "Product Id",
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/AssistantActionType"
          }
        },
        "required": [
          "type",
          "product_id"
        ],
        "title": "AssistantSuggestedActionResponse",
        "type": "object"
      },
      "ContentPlanAnalysis": {
        "additionalProperties": false,
        "properties": {
          "content_directions": {
            "items": {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            "title": "Content Directions",
            "type": "array"
          },
          "cultural_advantages": {
            "items": {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            "title": "Cultural Advantages",
            "type": "array"
          },
          "marketing_suggestions": {
            "items": {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            "title": "Marketing Suggestions",
            "type": "array"
          },
          "recommendation": {
            "$ref": "#/components/schemas/RecommendationLevel"
          },
          "risks": {
            "items": {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            "title": "Risks",
            "type": "array"
          },
          "score": {
            "description": "Heuristic assessment, not a sales forecast.",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Score",
            "type": "integer"
          },
          "strengths": {
            "items": {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            "title": "Strengths",
            "type": "array"
          },
          "summary": {
            "minLength": 1,
            "pattern": "\\S",
            "title": "Summary",
            "type": "string"
          },
          "target_audiences": {
            "items": {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            "title": "Target Audiences",
            "type": "array"
          }
        },
        "required": [
          "recommendation",
          "score",
          "summary",
          "target_audiences",
          "strengths",
          "risks",
          "cultural_advantages",
          "marketing_suggestions",
          "content_directions"
        ],
        "title": "ContentPlanAnalysis",
        "type": "object"
      },
      "ContentPlanErrorResponse": {
        "properties": {
          "code": {
            "const": "content_planning_failed",
            "title": "Code",
            "type": "string"
          },
          "message": {
            "const": "Unable to create content plan. Please try again.",
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ContentPlanErrorResponse",
        "type": "object"
      },
      "ContentPlanRequest": {
        "additionalProperties": false,
        "properties": {
          "analysis": {
            "$ref": "#/components/schemas/ContentPlanAnalysis"
          },
          "country": {
            "minLength": 1,
            "pattern": "\\S",
            "title": "Country",
            "type": "string"
          },
          "market_notes": {
            "anyOf": [
              {
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Market Notes"
          },
          "product_id": {
            "minLength": 1,
            "pattern": "\\S",
            "title": "Product Id",
            "type": "string"
          },
          "target_audience": {
            "anyOf": [
              {
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Audience"
          },
          "target_language": {
            "minLength": 1,
            "pattern": "\\S",
            "title": "Target Language",
            "type": "string"
          }
        },
        "required": [
          "product_id",
          "country",
          "target_language",
          "analysis"
        ],
        "title": "ContentPlanRequest",
        "type": "object"
      },
      "ContentPlanResponse": {
        "properties": {
          "image_prompt": {
            "minLength": 1,
            "pattern": "\\S",
            "title": "Image Prompt",
            "type": "string"
          },
          "key_selling_points": {
            "items": {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            "minItems": 1,
            "title": "Key Selling Points",
            "type": "array"
          },
          "live_script": {
            "minLength": 1,
            "pattern": "\\S",
            "title": "Live Script",
            "type": "string"
          },
          "short_video_idea": {
            "minLength": 1,
            "pattern": "\\S",
            "title": "Short Video Idea",
            "type": "string"
          },
          "short_video_prompt": {
            "minLength": 1,
            "pattern": "\\S",
            "title": "Short Video Prompt",
            "type": "string"
          },
          "social_caption": {
            "minLength": 1,
            "pattern": "\\S",
            "title": "Social Caption",
            "type": "string"
          }
        },
        "required": [
          "key_selling_points",
          "image_prompt",
          "short_video_idea",
          "short_video_prompt",
          "live_script",
          "social_caption"
        ],
        "title": "ContentPlanResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "providers": {
            "$ref": "#/components/schemas/ProvidersResponse"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "providers"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "ProductAnalysisErrorResponse": {
        "properties": {
          "code": {
            "enum": [
              "product_not_found",
              "llm_unavailable",
              "invalid_llm_response"
            ],
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ProductAnalysisErrorResponse",
        "type": "object"
      },
      "ProductAnalysisRequest": {
        "additionalProperties": false,
        "properties": {
          "country": {
            "minLength": 1,
            "pattern": "\\S",
            "title": "Country",
            "type": "string"
          },
          "market_notes": {
            "anyOf": [
              {
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Market Notes"
          },
          "product_id": {
            "minLength": 1,
            "pattern": "\\S",
            "title": "Product Id",
            "type": "string"
          },
          "target_audience": {
            "anyOf": [
              {
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Audience"
          }
        },
        "required": [
          "product_id",
          "country"
        ],
        "title": "ProductAnalysisRequest",
        "type": "object"
      },
      "ProductListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ProductResponse"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "ProductListResponse",
        "type": "object"
      },
      "ProductMarketAnalysisResponse": {
        "properties": {
          "content_directions": {
            "items": {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            "title": "Content Directions",
            "type": "array"
          },
          "cultural_advantages": {
            "items": {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            "title": "Cultural Advantages",
            "type": "array"
          },
          "marketing_suggestions": {
            "items": {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            "title": "Marketing Suggestions",
            "type": "array"
          },
          "recommendation": {
            "$ref": "#/components/schemas/RecommendationLevel"
          },
          "risks": {
            "items": {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            "title": "Risks",
            "type": "array"
          },
          "score": {
            "description": "Heuristic assessment, not a sales forecast.",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Score",
            "type": "integer"
          },
          "strengths": {
            "items": {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            "title": "Strengths",
            "type": "array"
          },
          "summary": {
            "minLength": 1,
            "pattern": "\\S",
            "title": "Summary",
            "type": "string"
          },
          "target_audiences": {
            "items": {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            "title": "Target Audiences",
            "type": "array"
          }
        },
        "required": [
          "recommendation",
          "score",
          "summary",
          "target_audiences",
          "strengths",
          "risks",
          "cultural_advantages",
          "marketing_suggestions",
          "content_directions"
        ],
        "title": "ProductMarketAnalysisResponse",
        "type": "object"
      },
      "ProductNotFoundResponse": {
        "properties": {
          "code": {
            "const": "product_not_found",
            "title": "Code",
            "type": "string"
          },
          "message": {
            "const": "Product not found",
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ProductNotFoundResponse",
        "type": "object"
      },
      "ProductResponse": {
        "properties": {
          "category": {
            "title": "Category",
            "type": "string"
          },
          "cultural_background": {
            "title": "Cultural Background",
            "type": "string"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "images": {
            "items": {
              "type": "string"
            },
            "title": "Images",
            "type": "array"
          },
          "ingredients": {
            "items": {
              "type": "string"
            },
            "title": "Ingredients",
            "type": "array"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "origin": {
            "title": "Origin",
            "type": "string"
          },
          "price": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Price"
          },
          "purchase_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Purchase Url"
          },
          "usage": {
            "title": "Usage",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "category",
          "description",
          "origin",
          "cultural_background",
          "images",
          "usage",
          "ingredients",
          "price",
